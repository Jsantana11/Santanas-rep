# Broker is Robinhood, accessed via the connected Robinhood MCP server —
# no API key needed here. Never add Alpaca credentials; scripts/alpaca.sh
# is unused/forbidden.

# Perplexity (research)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# Google Sheets (persistent memory — TRADE-LOG / RESEARCH-LOG tabs)
GOOGLE_SHEETS_ID=your_google_sheet_id_here
GOOGLE_CLIENT_EMAIL=your_service_account_email_here
GOOGLE_PRIVATE_KEY=your_service_account_private_key_here

# ClickUp (notifications — posts to a Chat channel)
CLICKUP_API_KEY=your_clickup_api_key_here
CLICKUP_WORKSPACE_ID=your_clickup_workspace_id_here
CLICKUP_CHANNEL_ID=your_clickup_channel_id_here
